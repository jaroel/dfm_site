{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "bun",
      "@testing-library/jest-dom",
      "vite/client"
    ],
    "isolatedModules": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
    },
  },
}
