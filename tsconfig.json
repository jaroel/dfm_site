{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "bun",
      "vite/client",
      "filesystem-routing/types",
      "@testing-library/jest-dom",
      "@responsive-image/vite-plugin/client"
    ],
    "isolatedModules": true,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
  },
  "include": [
    "src",
    "*.ts",
    "*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
}
