{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "filesystem-routing/types",
      "@testing-library/jest-dom",
      "@responsive-image/vite-plugin/client"
    ],
    "paths": {
      "~/ftp.ts": [
        "./types/ftp.d.ts"
      ],
      "~/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/App.tsx",
    "src/router.ts",
    "src/components",
    "src/routes",
    "src/uzg.ts",
    "src/recordings.ts",
    "src/groupby.ts",
    "src/global.d.ts",
    "file-routes.d.ts"
  ],
}
