{
  "name": "solid-site",
  "version": "0.1",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "build": "vite build",
    "start": "bun server.bun.ts",
    "preview": "bun node_modules/vite/bin/vite.js preview",
    "test": "vitest",
    "lint": "oxlint src types server.bun.ts vite.config.ts vitest.config.ts",
    "format": "oxfmt src types server.bun.ts vite.config.ts vitest.config.ts vitest-setup.ts",
    "format:check": "oxfmt --check src types server.bun.ts vite.config.ts vitest.config.ts vitest-setup.ts",
    "typecheck": "bun check --no-script && bun check -p tsconfig.client.json --no-script"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@fontsource/cabin": "^5.3.0",
    "@responsive-image/core": "^2.1.1",
    "@responsive-image/solid": "^2.1.0",
    "@responsive-image/vite-plugin": "^3.0.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/user-event": "^14.6.9",
    "@types/bun": "^1.4.4",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "^0.23.0-ts7.1.0-beta",
    "vite": "8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.19",
    "basic-ftp": "^6.2.6",
    "filesystem-routing": "0.4.2",
    "solid-js": "2.0.0-rc.19"
  }
}