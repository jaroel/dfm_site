{
  "name": "solid-site",
  "version": "0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun prerender.ts",
    "start": "bun server.bun.ts",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "oxlint src types prerender.ts server.bun.ts vite.config.ts vitest.config.ts",
    "format": "oxfmt src types prerender.ts server.bun.ts vite.config.ts vitest.config.ts vitest-setup.ts",
    "format:check": "oxfmt --check src types prerender.ts server.bun.ts vite.config.ts vitest.config.ts vitest-setup.ts",
    "typecheck": "bun check --no-script && bun check -p tsconfig.client.json --no-script"
  },
  "dependencies": {
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.1",
    "@solidjs/web": "2.0.0",
    "basic-ftp": "^6.2.6",
    "filesystem-routing": "0.5.0",
    "solid-js": "2.0.0"
  },
  "devDependencies": {
    "@fontsource/cabin": "^5.3.0",
    "@responsive-image/core": "^2.1.1",
    "@responsive-image/solid": "^2.1.0",
    "@responsive-image/vite-plugin": "^3.0.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "^14.6.13",
    "@types/bun": "^1.4.5",
    "eslint-plugin-solid": "0.19.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.5"
}
